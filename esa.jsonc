{
  "name": "chabing-blog",
  "installCommand": "",
  "buildCommand": "set -e; HUGO_VERSION=0.168.0; curl -fsSL -o /tmp/hugo.tgz https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-amd64.tar.gz; tar -xzf /tmp/hugo.tgz -C /tmp hugo; HUGO_PARAMS_GITCOMMIT=$(git rev-parse HEAD) /tmp/hugo --gc --minify --destination public",
  "assets": { "directory": "./public" }
}
